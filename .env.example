# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it or any file containing real keys/ids.

# --- Single-tenant mode ---
# Required only if some tool call will run WITHOUT an organization_id.
RAPID7_API_KEY=

# --- Multi-tenant mode ---
# Required to call any tool with organization_id set, and for get_organization_ids.
RAPID7_MULTI_TENANT_API_KEY=

# Required only for get_organization_ids. This is YOUR primary/parent
# account's own organization id — not any managed tenant's id.
RAPID7_PARENT_ORG_ID=

# --- Shared ---
# Required. One of: us, us2, us3, eu, ca, au, ap
RAPID7_REGION=

# --- Local/optional ---
# Directory for database files (default: ~/.rapid7_mcp locally, /data in Docker).
# DATA_DIR=

# Transport for the MCP server: stdio (default, local) or http (Docker/remote).
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- Cloudflare Access (client-side; not read by this server) ---
# If the /mcp endpoint sits behind a Cloudflare Access application (recommended
# for remote deployments, since /mcp itself has no built-in auth), the
# connecting MCP client needs a Cloudflare Access service token to send as
# CF-Access-Client-Id / CF-Access-Client-Secret request headers. These are not
# environment variables this server reads — they live in the client's config.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
